# MongoDB Atlas connection string (from your Cluster0 -> Connect -> Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="convtree"

# LLM provider defaults (can be overridden per-request from the UI dropdown)
# provider: "ollama" (local, no key) or "openai"
DEFAULT_PROVIDER="ollama"

# Ollama (local) — run `ollama serve` and `ollama pull llama3.2` + `ollama pull nomic-embed-text`
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="llama3.2"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# OpenAI (teammate's key) — used for the deployed public demo
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBED_MODEL="text-embedding-3-small"

# Embedding dimension for the Atlas vector index.
# nomic-embed-text = 768, text-embedding-3-small = 1536.
# Pick ONE embedder for the whole demo so the index dimension stays consistent.
EMBED_DIM="768"
